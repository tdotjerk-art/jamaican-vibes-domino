diff --git a/preview-access.js b/preview-access.js
new file mode 100644
index 0000000..9221b26
--- /dev/null
+++ b/preview-access.js
@@ -0,0 +1,24 @@
+'use strict';
+
+const { createHash, timingSafeEqual } = require('node:crypto');
+
+function protectPreview(app, io, password) {
+  if (!password) throw new Error('JAMDOWN_PREVIEW_PASSWORD is required for a hosted preview.');
+
+  const digest = value => createHash('sha256').update(value).digest();
+  const expected = digest('Basic ' + Buffer.from('jamdown:' + password).toString('base64'));
+
+  function authorize(req, res, next) {
+    res.setHeader('Cache-Control', 'private, no-store');
+    res.setHeader('X-Robots-Tag', 'noindex');
+    if (timingSafeEqual(digest(req.headers.authorization || ''), expected)) return next();
+
+    res.writeHead(401, { 'WWW-Authenticate': 'Basic realm="JamDown Games", charset="UTF-8"' });
+    res.end('JamDown Games private preview');
+  }
+
+  app.use(authorize);
+  io.engine.use(authorize);
+}
+
+module.exports = { protectPreview };
