# Node does not load this automatically. Set these in your hosting dashboard.
NODE_ENV=production
APP_URL=https://your-game.example
# Use a persistent disk, not the temporary deployment filesystem.
DATABASE_PATH=/var/data/members.sqlite
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Active CAD 9.99/month recurring Stripe Price (no trial configured in Checkout).
STRIPE_VIP_PRICE_ID=
